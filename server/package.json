    "migrate:local": "wrangler d1 migrations apply guildwright --local"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.158.0"
  }
}
