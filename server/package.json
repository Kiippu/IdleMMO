{
  "name": "@guildwright/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/server/dev.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate:local": "node ../scripts/server/migrate.mjs",
    "backup": "node ../scripts/server/backup.mjs",
    "restore-check": "node ../scripts/server/restore-check.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.158.0"
  }
}
