{
  "name": "guildwright",
  "private": true,
  "version": "0.0.0",
  "workspaces": ["engine", "client", "server"],
  "engines": { "node": ">=22" },
  "scripts": {
    "dev:client": "npm run dev -w @guildwright/client",
    "dev:server": "npm run dev -w @guildwright/server",
    "serve": "npm run dev -w @guildwright/server -- --port 4173",
    "tunnel": "cloudflared tunnel --url http://localhost:4173",
    "art": "python3 scripts/art/build.py",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  }
}
