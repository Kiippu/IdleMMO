{
  "name": "@guildwright/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Guildwright game engine (rules + state, no DOM). TypeScript port of the prototype engine.",
  "main": "src/index.ts",
  "types": "src/public.d.ts",
  "exports": {
    ".": {
      "types": "./src/public.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "extract-legacy": "node scripts/extract-legacy.mjs",
    "balance": "node ../scripts/balance/run.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
